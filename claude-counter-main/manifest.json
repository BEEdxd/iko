{
    "manifest_version": 3,
    "name": "IKO Context HUD",
    "version": "0.1.0",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chat.openai.com/*",
        "http://localhost:3000/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://claude.ai/*",
                "https://*.claude.ai/*"
            ],
            "js": [
                "dist/claude-content.js",
                "dist/migration.js"
            ],
            "css": [
                "dist/style.css",
                "dist/migration.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://*.chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://*.chat.openai.com/*"
            ],
            "js": [
                "dist/content.js",
                "dist/migration.js"
            ],
            "css": [
                "dist/style.css",
                "dist/migration.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://claude.ai/*",
                "https://*.claude.ai/*"
            ],
            "js": [
                "dist/claude-bridge.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ]
}